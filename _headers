/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://hfmwcmgoduvhmmjiyteh.supabase.co; upgrade-insecure-requests
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY

# The app reads the blog's posts from these files, also on the web at
# admin.laviju.lt/app/.
/blog/app/*
  Access-Control-Allow-Origin: *

# ...and shows the posts' pictures there.
/blog/assets/*
  ! Cross-Origin-Resource-Policy

# ...and the posts themselves, in a frame there. A rule's "!" drops what
# earlier rules set before it sets its own, so this replaces the policy.
/blog/*
  ! Content-Security-Policy
  ! X-Frame-Options
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors https://admin.laviju.lt; form-action 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://hfmwcmgoduvhmmjiyteh.supabase.co; upgrade-insecure-requests
